geom_histogram(bins = 10, fill = "darkblue", alpha = 0.5) +
geom_text(stat = "bin", bins = 10, aes(label = stat(count),
y = stat(count)),
nudge_y = 2, color = "darkblue", size = 3) +
scale_x_continuous(breaks = 1:7) +
theme_bw()
help(mpg)
head(mpg)
ggplot(mpg, aes(x = cty)) +
geom_histogram()
